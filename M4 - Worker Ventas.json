            "nombre": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('nombre', `Nombre de la persona que realiza la consulta. Extraer únicamente si aparece explícitamente en el mensaje. No inventar.`, 'string') }}",
            "empresa": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('empresa', `Nombre de la empresa u organización mencionada explícitamente por el usuario. No inferir ni inventar.`, 'string') }}",
            "email": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('email', `Dirección de correo electrónico proporcionada explícitamente por el usuario. Si no fue informada, no inventar ninguna dirección.`, 'string') }}",
            "necesidad": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('necesidad', `Descripción breve de la necesidad comercial concreta expresada por el usuario.`, 'string') }}",
            "prioridad": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('prioridad', `Prioridad comercial de la oportunidad. Utilizar exclusivamente ALTA, MEDIA o BAJA.`, 'string') }}",
